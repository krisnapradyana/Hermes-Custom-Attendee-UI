# --- Auth (same Slack app as the main assistant) ---------------------------
# Add this redirect URL in the Slack app settings:
#   https://clock.<your-domain>/api/auth/callback/slack
NEXT_PUBLIC_AUTH_ENABLED=true
AUTH_SECRET=            # openssl rand -base64 33  (its own secret, NOT the main app's)
AUTH_SLACK_ID=          # Slack app Client ID (same as main app)
AUTH_SLACK_SECRET=      # Slack app Client Secret (same as main app)
AUTH_URL=https://clock.your-domain.example/api/auth

# --- Integration with the main assistant app --------------------------------
# Internal Docker-network URL of the main app (NOT the public domain).
MAIN_APP_URL=http://assistant-web:3000
# Shared secret — set the SAME value in the main app's .env.local.
# openssl rand -hex 32
INTERNAL_TOKEN=

# --- Studio settings ---------------------------------------------------------
# Wall-clock offset for "today"/"this week" boundaries. 480 = UTC+8 (WITA).
TIMECLOCK_TZ_OFFSET_MIN=480

# Where session JSON lives (set by Dockerfile in production).
# DATA_DIR=./data
